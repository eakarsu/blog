#!/usr/bin/env bash
set -euo pipefail

if [[ "${RAILS_ENV:-development}" == "production" ]]; then
  : "${DATABASE_URL:?DATABASE_URL is required}"
  : "${SECRET_KEY_BASE:?SECRET_KEY_BASE is required}"
  : "${APP_HOST:?APP_HOST is required}"
  if [[ ${#SECRET_KEY_BASE} -lt 64 ]] || [[ "$SECRET_KEY_BASE" =~ (change|example|dummy|secret-key) ]]; then
    echo "SECRET_KEY_BASE must be a non-placeholder value of at least 64 characters" >&2
    exit 1
  fi
fi

if [[ "${RUN_MIGRATIONS:-false}" == "true" ]]; then
  bundle exec rails db:migrate
fi

exec bundle exec puma -C config/puma.rb
