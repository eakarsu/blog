<nav class="navbar navbar-default" aria-label="Primary navigation">
  <div class="container-fluid">
    <div class="navbar-header">
      <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#primary-links" aria-expanded="false">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
      </button>
      <%= link_to "Blog", root_path, class: "navbar-brand", id: "logo" %>
    </div>
    <div class="collapse navbar-collapse" id="primary-links">
      <ul class="nav navbar-nav">
        <li><%= link_to "Articles", articles_path %></li>
        <li><%= link_to "Categories", categories_path %></li>
        <li><%= link_to "Atom feed", feed_path(format: :atom) %></li>
        <% if logged_in? %>
          <li><%= link_to "New draft", new_article_path %></li>
        <% end %>
        <% if current_user&.administrator? %>
          <li><%= link_to "Manage users", users_path %></li>
          <li><%= link_to "New category", new_category_path %></li>
          <li><%= link_to "Export", export_path %></li>
          <li><%= link_to "Audit", audit_events_path %></li>
        <% end %>
      </ul>
      <%= form_tag articles_path, method: :get, role: "search", class: "navbar-form navbar-left" do %>
        <%= label_tag :q, "Search articles", class: "sr-only" %>
        <%= search_field_tag :q, params[:q], class: "form-control", placeholder: "Search published articles" %>
        <%= submit_tag "Search", class: "btn btn-default" %>
      <% end %>
      <ul class="nav navbar-nav navbar-right">
        <% if logged_in? %>
          <li><%= link_to "Profile", user_path(current_user) %></li>
          <li><%= link_to "Log out", logout_path, method: :delete %></li>
        <% else %>
          <li><%= link_to "Log in", login_path %></li>
          <li><%= link_to "Sign up", signup_path %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
