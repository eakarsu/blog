<h1 class="text-center"><%= @user.username %>'s articles</h1>
<div class="row">
  <div class="col-md-4 col-md-offset-4 center">
    <%= gravatar_for @user, size: 150 %>
  </div>
</div>
<h2 class="text-center"><%= logged_in? && (current_user == @user || current_user.editor?) ? "Published and private work" : "Published work" %></h2>

<div class="center">
  <%= will_paginate @user_articles %>
</div>
<%= render 'articles/article', obj: @user_articles %>
<div class="center">
  <%= will_paginate @user_articles %>
</div>

