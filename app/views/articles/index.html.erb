<h1 class="text-center">Articles</h1>
<%= form_tag articles_path, method: :get, role: "search", class: "text-center" do %>
  <%= label_tag :q, "Search articles", class: "sr-only" %>
  <%= search_field_tag :q, params[:q], placeholder: "Search articles" %>
  <%= submit_tag "Search" %>
<% end %>
<% if current_user&.administrator? %>
  <section aria-labelledby="archive-heading">
    <h2 id="archive-heading">Portable archive</h2>
    <p><%= link_to "Download archive", export_path, class: "btn btn-default" %></p>
    <%= form_tag import_path, multipart: true do %>
      <%= label_tag :archive, "Restore a Blog JSON archive (maximum 10 MiB)" %>
      <%= file_field_tag :archive, required: true, accept: "application/json" %>
      <%= submit_tag "Import archive", class: "btn btn-warning", data: { confirm: "Validate and import this archive?" } %>
    <% end %>
  </section>
<% end %>
<div align="center">
  <%= will_paginate %>
</div>
<%= render 'article', obj: @articles %>
<div align="center">
  <%= will_paginate %>
</div>
